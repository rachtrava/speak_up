# Copy to .env and fill in. Never commit .env.
# Public HTTPS URL that ChatGPT/Claude will reach (your tunnel URL). http://localhost:8000 for local-only use.
COMMONS_PUBLIC_URL=http://localhost:8000
COMMONS_PORT=8000
COMMONS_DB=data/commons.db
# Telegram (optional). Create a bot with @BotFather, add it to a private group.
TELEGRAM_BOT_TOKEN=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token on webhook calls.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated redirect URI prefixes allowed for OAuth connectors (defaults cover ChatGPT, Claude, localhost).
# COMMONS_REDIRECT_ALLOWLIST=https://chatgpt.com/,https://claude.ai/
